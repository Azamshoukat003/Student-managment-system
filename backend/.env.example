# ─────────────────────────────────────────────────────────────
# Copy this file to  backend/.env  and fill in real values.
# NEVER commit .env (it is gitignored).
# ─────────────────────────────────────────────────────────────

# Neon PostgreSQL connection string.
# Example: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Leave blank / omit to fall back to a local SQLite dev database.
DATABASE_URL=

# JWT signing secret — generate a long random string for production.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# First admin account, seeded on startup if no admin exists.
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@attendance.local
ADMIN_PASSWORD=admin123

# Comma-separated list of allowed frontend origins (CORS).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Attendance tuning (spec §9, §10).
FACE_MATCH_THRESHOLD=0.75
FACE_PENDING_THRESHOLD=0.60
MAX_GPS_ACCURACY=100
DEFAULT_RADIUS_METERS=100
